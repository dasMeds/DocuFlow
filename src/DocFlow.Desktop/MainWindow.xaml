<Window x:Class="DocFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocFlow — Async Document Processing Pipeline" Height="560" Width="920"
        AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="DocFlow Pipeline Workbench" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Select Files..." Margin="16,0,0,0" Padding="12,6" Click="SelectFiles_Click"/>
        </StackPanel>

        <!-- Drag-and-drop file intake zone -->
        <Border Grid.Row="1" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="8" Background="#F8FAFC" Margin="0,0,0,12">
            <TextBlock Text="Drag and drop PDFs, invoices, CSVs, or TXT files here to enqueue"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#475569"/>
        </Border>

        <!-- Real-time job status DataGrid bound to MainViewModel.Jobs -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*"/>
                <DataGridTextColumn Header="Invoice #" Binding="{Binding ExtractedData.InvoiceNumber}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding ExtractedData.TotalAmount, StringFormat=C}" Width="*"/>
                <DataGridTextColumn Header="Notes / Errors" Binding="{Binding ReviewNote}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
