<Window x:Class="DocFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocFlow — Async Document Processing Pipeline" Height="620" Width="1040"
        MinHeight="480" MinWidth="760" Background="{StaticResource WindowBackgroundBrush}"
        AllowDrop="True" Drop="Window_Drop">
    <!-- The window uses shared color and control resources from Styles/. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="DocFlow Pipeline Workbench" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Document intake and extraction status" Margin="0,4,0,0"
                           Style="{StaticResource SecondaryText}"/>
            </StackPanel>
            <Button Content="Select files" Margin="20,4,0,0" Click="SelectFiles_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DropZoneBorder}" Margin="0,0,0,16">
            <TextBlock Text="Drop PDF, Word, PowerPoint, HTML, image, text, CSV, JSON, or Markdown documents here"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource JobDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Document" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Invoice #" Binding="{Binding ExtractedData.InvoiceNumber}" Width="*"/>
                <DataGridTextColumn Header="Vendor" Binding="{Binding ExtractedData.VendorName}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding ExtractedData.TotalAmount, StringFormat=C}" Width="*"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding ReviewNote}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
